{
	"compilerOptions": {
		"outDir": "./dist/",
		"noImplicitAny": false,
		"module": "esnext",
		"target": "esnext",
		"allowJs": true,
		"moduleResolution": "bundler"
	},
	"include": ["core/**/*", "modules/**/*", "frontend/shared/**/*"],
	// covered by frontend/tsconfig.json
	"exclude": ["frontend/shared/**/*.test.ts"]
}
